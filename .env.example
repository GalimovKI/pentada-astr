POSTGRES_DB=mailsearch
POSTGRES_USER=mailsearch
POSTGRES_PASSWORD=replace_with_random_password
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg://mailsearch:replace_with_random_password@127.0.0.1:5432/mailsearch
# Optional, only for integration tests; role must have CREATEDB.
# TEST_DATABASE_ADMIN_URL=postgresql+psycopg://mailsearch:replace_with_random_password@127.0.0.1:5432/postgres
# HTTP server only. Paths are relative to the launch directory when overridden.
SEARCH_ENGINE_FACTORY=mail_search.core.engine:load_event_aware
SEARCH_CONFIG=configs/search/bm25-event-aware.json
SEARCH_DATASET=data/raw/mipt_mail_search_participants.zip
# Enable only for a separate dev backend. Benchmarks run on the local corpus.
ENABLE_EVALUATIONS=false
# Optional writable directory for metrics, predictions and reports.
# EVALUATION_DIR=reports/quality/runs/dev-site
# Optional separate databases imported from the matching EnronQA archives.
# ENRONQA_RU_DATABASE_URL=postgresql+psycopg://mailsearch:replace_with_random_password@127.0.0.1:5432/pentada_dev_enronqa_ru
# ENRONQA_EN_DATABASE_URL=postgresql+psycopg://mailsearch:replace_with_random_password@127.0.0.1:5432/pentada_dev_enronqa_en
