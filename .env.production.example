# Copy to .env.production; replace BOTH password placeholders with your own value.
# A hex password avoids URL quoting and Compose interpolation problems.
POSTGRES_DB=mailsearch
POSTGRES_USER=mailsearch
POSTGRES_PASSWORD=replace_with_random_password
DATABASE_URL=postgresql+psycopg://mailsearch:replace_with_random_password@db:5432/mailsearch
# Host path, relative to compose.production.yaml or absolute. File must exist.
CORPUS_PATH=./data/raw/mipt_mail_search_participants.zip
# Paths below are INSIDE the backend container.
SEARCH_DATASET=/data/corpus.zip
SEARCH_CONFIG=/app/configs/search/bm25-event-aware.json
SEARCH_ENGINE_FACTORY=mail_search.core.engine:load_event_aware
APP_IMAGE_TAG=local
ENGINE_START_PERIOD=180s
SITE_ADDRESS=http://:80
HTTP_BIND=127.0.0.1
HTTP_PORT=8080
HTTPS_BIND=127.0.0.1
HTTPS_PORT=8443
