{
	admin off
}

http://127.0.0.1:8081 {
	bind 127.0.0.1
	respond /health/web "live" 200
}

{$SITE_ADDRESS} {
	@devHttp {
		path /dev /dev/*
		protocol http
	}
	redir @devHttp https://smartmail-hackaton.ru{uri} 308
	redir / /main/ 302
	redir /main /main/ 308
	redir /dev /dev/ 308
	handle /main/* {
		reverse_proxy 127.0.0.1:18080
	}
	handle /dev/* {
		basic_auth bcrypt SmartMail-dev {
			import /run/secrets/dev_users
		}
		reverse_proxy 127.0.0.1:18090 {
			header_up -Authorization
		}
	}
	respond 404
}
