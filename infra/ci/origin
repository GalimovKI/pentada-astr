#!/bin/sh
set -eu
export PATH="$HOME/.local/lib/pentada-docker/bin:$HOME/bin:$PATH"
root=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
environment=$(cat "$root/ENVIRONMENT")
case "$environment" in
  main) project=pentada-mailsearch ;;
  dev) project=pentada-mailsearch-dev ;;
  *) echo 'Unknown environment' >&2; exit 1 ;;
esac
release=$(readlink -f "$root/current")
APP_IMAGE_TAG=$(basename "$release")
if [ -f "$release/DEPLOYMENT_ENV" ]; then APP_IMAGE_TAG="$environment-$APP_IMAGE_TAG"; fi
export APP_IMAGE_TAG
if [ -f "$root/shared/gpu-device" ] && [ -f "$release/compose.gpu.yaml" ]; then
  GPU_CDI_DEVICE=$(cat "$root/shared/gpu-device")
  if ! printf '%s\n' "$GPU_CDI_DEVICE" | grep -Eq '^nvidia\.com/gpu=([0-9]+|GPU-[0-9a-fA-F-]+)$'; then
    echo 'gpu-device must select exactly one NVIDIA CDI device' >&2; exit 1
  fi
  export GPU_CDI_DEVICE
  set -- -f "$release/compose.gpu.yaml" "$@"
fi
if [ "$environment" = dev ] && [ -n "${PENTADA_DEV_E5_GPU:-}" ] && [ -f "$release/compose.dev-gpu.yaml" ]; then
  if ! printf '%s\n' "$PENTADA_DEV_E5_GPU" | grep -Eq '^([0-9]+|GPU-[0-9a-fA-F-]{36})$'; then
    echo 'Expected one E5 GPU index or UUID' >&2; exit 1
  fi
  if [ -n "${GPU_CDI_DEVICE:-}" ] && [ "$GPU_CDI_DEVICE" != "nvidia.com/gpu=$PENTADA_DEV_E5_GPU" ]; then
    echo 'E5 and MiniLM must select the same CDI identifier' >&2; exit 1
  fi
  set -- -f "$release/compose.dev-gpu.yaml" "$@"
fi
if [ "$environment" = dev ] && [ -f "$release/compose.dev-evaluations.yaml" ]; then
  set -- -f "$release/compose.dev-evaluations.yaml" "$@"
fi
exec docker --context rootless compose --env-file "$root/shared/.env.production" \
  -p "$project" -f "$release/compose.production.yaml" -f "$release/compose.origin.yaml" "$@"
